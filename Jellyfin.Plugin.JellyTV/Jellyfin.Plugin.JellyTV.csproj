<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.JellyTV</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <!--
      Set this to match the Jellyfin server version you are targeting.
      Check https://www.nuget.org/packages/Jellyfin.Controller/ for available versions.
    -->
    <JellyfinVersion>12.1.0</JellyfinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ExcludeAssets="runtime" prevents Jellyfin assemblies from being bundled into
      the plugin .dll — the server provides them at runtime via its own assembly loader.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core types (ControllerBase, IHttpClientFactory, etc.) — part of the shared runtime, not bundled -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Code analysis packages (build-time only, never shipped with the plugin) -->
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <!-- The config page is authored as pieces in Configuration/Page (shell, css, i18n, app) and joined into the single
       configPage.html that Jellyfin serves; the shell marks each piece with an include comment. -->
  <UsingTask TaskName="JoinConfigPage" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Folder ParameterType="System.String" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var page = File.ReadAllText(Path.Combine(Folder, "page.html"));
        foreach (var piece in new[] { "page.css", "i18n.js", "app.js" })
        {
            var marker = new System.Text.RegularExpressions.Regex("<!--@include " + piece + @"-->\r?\n");
            if (!marker.IsMatch(page)) { Log.LogError("page.html no incluye " + piece); return false; }
            var text = File.ReadAllText(Path.Combine(Folder, piece));
            page = marker.Replace(page, m => text);
        }
        Directory.CreateDirectory(Path.GetDirectoryName(Output));
        File.WriteAllText(Output, page);
      ]]></Code>
    </Task>
  </UsingTask>

  <ItemGroup>
    <JellyTvPagePiece Include="Configuration\Page\*" />
  </ItemGroup>

  <Target Name="JoinConfigPage" BeforeTargets="AssignTargetPaths" Inputs="@(JellyTvPagePiece)" Outputs="$(IntermediateOutputPath)configPage.html">
    <JoinConfigPage Folder="$(MSBuildProjectDirectory)\Configuration\Page" Output="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)configPage.html" />
  </Target>

  <Target Name="EmbedConfigPage" BeforeTargets="AssignTargetPaths" DependsOnTargets="JoinConfigPage">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)configPage.html" LogicalName="Jellyfin.Plugin.JellyTV.Configuration.configPage.html" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="JellyTV.HlsRegression" />
  </ItemGroup>

</Project>
